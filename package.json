{
  "name": "playwright-rerun-mcp",
  "mcpName": "io.github.ibtsam2666/playwright-rerun-mcp",
  "version": "1.1.0",
  "description": "MCP server that lets an AI assistant list failed or flaky Playwright tests and rerun only those, or rerun by test-case ID.",
  "license": "MIT",
  "author": "Ibtsam Ayyaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibtsam2666/playwright-rerun-mcp.git"
  },
  "homepage": "https://github.com/ibtsam2666/playwright-rerun-mcp#readme",
  "bugs": {
    "url": "https://github.com/ibtsam2666/playwright-rerun-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "testing",
    "claude",
    "flaky-tests",
    "test-automation",
    "ci"
  ],
  "bin": {
    "playwright-rerun-mcp": "dist/cli.js",
    "playwright-rerun-summary": "dist/summary.js"
  },
  "main": "dist/tools.js",
  "files": [
    "dist",
    "!dist/smoke.*",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "playwright test --project=unit",
    "smoke": "npm run build && node dist/smoke.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-playwright": "2.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
